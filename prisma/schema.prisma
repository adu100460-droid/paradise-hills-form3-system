generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum SubjectType {
  CORE
  ELECTIVE
}

enum MockStatus {
  DRAFT
  MARKS_SUBMITTED
  FINALIZED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       Teacher?
  student       Student?
}

model SchoolSetting {
  id                 String   @id @default(cuid())
  schoolName         String   @default("Paradise Hills School")
  motto              String   @default("Love, Care & Discipline")
  academicYear       String   @default("2026/2027")
  logoUrl            String?
  resultSlipTitle    String   @default("Paradise Hills School")
  resultSlipSubtitle String   @default("Official Mock Examination Result Slip")
  gradingRules       String   @default("{\"90\":1,\"80\":2,\"70\":3,\"60\":4,\"55\":5,\"50\":6,\"40\":7,\"35\":8,\"0\":9}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Teacher {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  email          String
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  teacherSubjects TeacherSubject[]
}

model Student {
  id                  String     @id @default(cuid())
  userId              String     @unique
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String
  email               String
  photoUrl            String?
  className           String?
  stream              String?
  academicCohort     String?
  phsIndex           String     @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  marks               MarkEntry[]
  results             ResultSlip[]
}

model Subject {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  type        SubjectType
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  teacherAssignments TeacherSubject[]
  marks       MarkEntry[]
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId])
}

model MockExam {
  id            String      @id @default(cuid())
  name          String
  academicYear  String
  status        MockStatus  @default(DRAFT)
  finalizedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  marks         MarkEntry[]
  results       ResultSlip[]
}

model MarkEntry {
  id          String   @id @default(cuid())
  studentId   String
  subjectId   String
  mockId      String
  rawScore    Float?
  grade       Int?
  remark      String?
  isAbsent    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  mock        MockExam @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, mockId])
}

model ResultSlip {
  id                  String    @id @default(cuid())
  studentId           String
  mockId              String
  aggregate6          Int?
  selectedRawScore    Float?
  totalRawScore       Float?
  gradeSummary        String?
  officialCertificateId String   @unique @default(cuid())
  verificationToken   String    @unique
  qrCodeDataUrl       String?
  issuedAt            DateTime  @default(now())
  isValid             Boolean   @default(true)

  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mock                MockExam  @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@unique([studentId, mockId])
}
